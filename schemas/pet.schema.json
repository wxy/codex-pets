{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wxy/codex-pets/blob/main/schemas/pet.schema.json",
  "title": "Codex Pet v2 manifest",
  "type": "object",
  "required": ["id", "displayName", "description", "spriteVersionNumber", "spritesheetPath"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "displayName": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "spriteVersionNumber": { "const": 2 },
    "spritesheetPath": { "const": "spritesheet.webp" }
  },
  "additionalProperties": true
}
